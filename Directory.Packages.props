<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="FluentResults" Version="4.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="MVFC.Mediator" Version="4.0.0" />
    <PackageVersion Include="MVFC.Pack.Testing" Version="4.0.2" />
    <PackageVersion Include="MVFC.Pack.Analyzers" Version="4.0.2" />
    <PackageVersion Include="Google.Cloud.Storage.V1" Version="5.0.0" />
    <PackageVersion Include="Google.Cloud.PubSub.V1" Version="3.39.0" />
    <PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="15.1.0" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Refit" Version="16.4.0" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="16.4.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="11.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>